# Copy this file to .env and fill in your own values. Never commit .env.

# Backend URL. Leave empty in development (Vite proxies /api to localhost:5001).
VITE_API_URL=

# Google Maps JavaScript API key (restrict it to your site's URLs in Google Cloud).
VITE_GOOGLE_MAPS_API_KEY=

# Optional: your own Map ID. If empty, Google's DEMO_MAP_ID is used (fine for development).
VITE_GOOGLE_MAPS_MAP_ID=
