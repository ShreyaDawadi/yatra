# Copy to .env and fill in. Never commit .env.
PORT=5001
DATABASE_URL=postgres://postgres@localhost:5432/yatra
# Set to true when the database requires SSL (most hosted databases reached from outside)
DATABASE_SSL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# Frontend address(es), comma-separated. Used for CORS and password reset links.
CLIENT_URL=http://localhost:5173
